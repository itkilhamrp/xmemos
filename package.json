{
  "name": "xmemos",
  "version": "2.7.32",
  "private": true,
  "type": "module",
  "license": "AGPL-3.0-or-later",
  "description": "Privacy-first, 100% offline Android microblogging and knowledge-capture app with 1:1 Official Memos SQLite compatibility.",
  "packageManager": "pnpm@12.23.0",
  "engines": {
    "node": ">=22.14.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "dev": "vite dev --port 1420 --strictPort",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "lint": "pnpm version:check && pnpm check",
    "test": "vitest run",
    "version:check": "tsx scripts/sync-version.ts --check",
    "version:sync": "tsx scripts/sync-version.ts --sync",
    "license:apply": "tsx scripts/license.ts --apply",
    "license:check": "tsx scripts/license.ts --check",
    "foss:check": "tsx scripts/check-foss.ts",
    "tauri": "tauri"
  },
  "dependencies": {
    "@tauri-apps/api": "2.12.5",
    "dompurify": "3.5.0",
    "katex": "0.19.1",
    "konsta": "5.5.0",
    "leaflet": "1.9.4",
    "lucide-svelte": "1.0.1",
    "marked": "18.3.0",
    "prismjs": "1.30.0"
  },
  "devDependencies": {
    "@sveltejs/adapter-static": "4.0.1",
    "@sveltejs/kit": "3.4.0",
    "@sveltejs/vite-plugin-svelte": "7.3.2",
    "@tailwindcss/vite": "4.3.5",
    "@tauri-apps/cli": "2.12.6",
    "@types/dompurify": "3.2.0",
    "@types/katex": "0.16.8",
    "@types/leaflet": "1.9.22",
    "@types/node": "22.15.3",
    "@types/prismjs": "1.26.6",
    "svelte": "5.59.1",
    "svelte-check": "4.7.8",
    "tailwindcss": "4.3.5",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vite": "8.3.8",
    "vitest": "5.1.1"
  },
  "imports": {
    "#lib/*": "./src/lib/*"
  }
}
