<component type="desktop-application">
  <id>org.xmemos.app</id>
  <launchable type="desktop-id">org.xmemos.app.desktop</launchable>
  <name>Xmemos</name>
  <summary>Privacy-first, 100% offline microblogging and knowledge-capture app</summary>
  <developer id="org.xmemos">
    <name>Xmemos Contributors</name>
  </developer>
  <metadata_license>FSFAP</metadata_license>
  <project_license>AGPL-3.0-or-later</project_license>
  <url type="homepage">https://github.com/xmemos/xmemos</url>
  <url type="vcs-browser">https://github.com/xmemos/xmemos</url>
  <content_rating type="oars-1.1" />
  <branding>
    <color type="primary" scheme_preference="light">#007aff</color>
    <color type="primary" scheme_preference="dark">#0a84ff</color>
  </branding>
  <recommends>
    <display_length compare="ge">360</display_length>
  </recommends>
  <supports>
    <control>pointing</control>
    <control>keyboard</control>
    <control>touch</control>
  </supports>
  <keywords>
    <keyword>notes</keyword>
    <keyword>memos</keyword>
    <keyword>markdown</keyword>
    <keyword>sqlite</keyword>
    <keyword>offline</keyword>
    <keyword>privacy</keyword>
  </keywords>
  <description>
    <p>
      Xmemos is a privacy-first, 100% offline microblogging, journaling, and personal
      knowledge-capture desktop and mobile application featuring 1:1 SQLite database
      compatibility with Official FOSS Memos.
    </p>
    <p>
      All data is stored locally in a WAL-mode SQLite database with full-text search (FTS5),
      rich Markdown/KaTeX rendering, atomic backup/restore, and zero telemetry or cloud
      dependencies.
    </p>
  </description>
