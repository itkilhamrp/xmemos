<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/sticky_widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_sticky_widget"
    android:orientation="vertical"
    android:padding="13dp">

    <!-- Use @RemoteView-safe FrameLayout instead of plain View (which causes InflateException in AppWidgetHostView) -->
    <FrameLayout
        android:layout_width="38dp"
        android:layout_height="4dp"
        android:layout_marginBottom="8dp"
        android:background="@color/xmemos_widget_accent" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingBottom="6dp">

        <TextView
            android:id="@+id/sticky_widget_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Xmemos"
            android:textColor="@color/xmemos_widget_title"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/sticky_widget_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingStart="6dp"
            android:text="Xmemos"
            android:textColor="@color/xmemos_widget_badge"
            android:textSize="10sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:id="@+id/sticky_widget_body"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:ellipsize="end"
        android:lineSpacingExtra="2.5dp"
        android:maxLines="12"
        android:text="Tap to open memo in Xmemos"
        android:textColor="@color/xmemos_widget_body"
        android:textSize="12.5sp" />

    <TextView
        android:id="@+id/sticky_widget_meta"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:paddingTop="6dp"
        android:text=""
        android:textColor="@color/xmemos_widget_badge"
        android:textSize="10.5sp"
        android:visibility="gone" />
</LinearLayout>
